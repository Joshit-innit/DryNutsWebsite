NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Next.js API fallback auth (used when NEXT_PUBLIC_API_URL is not set)
# AUTH_SECRET is required in production (32+ chars). In dev a random one is generated per server start.
AUTH_SECRET=
# Admin account seeded on first run. Dev default: admin@nutrination.in / NutriAdmin@2026
ADMIN_EMAIL=admin@nutrination.in
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local)
# ---------------------------------------------------------------------------
# The browser only ever calls this site's /api/v1 routes. Sign-in is forwarded to
# the Spring gateway, so it must be running; the store data stays in Supabase.
BACKEND_URL=http://localhost:8080

# Supabase (Project Settings → API). The secret key is server-only: never
# prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_URL=https://ofpngbmneahgfndtbsxo.supabase.co
SUPABASE_SECRET_KEY=

# Verifies sign-in tokens. Must equal JWT_SECRET on the customer-service (32+ chars).
AUTH_SECRET=
# The admin account now lives in the customer-service, which seeds it from its own
# ADMIN_EMAIL / ADMIN_PASSWORD. ADMIN_EMAIL here is the public support address.
ADMIN_EMAIL=
# ---------------------------------------------------------------------------
# Spring backend on Supabase (optional). Use the Session pooler connection
# string from Supabase → Connect. Each service gets its own schema.
# ---------------------------------------------------------------------------
# POSTGRES_USER=postgres.ofpngbmneahgfndtbsxo
# POSTGRES_PASSWORD=<database password>
# PRODUCT_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
# CUSTOMER_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
# ORDER_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
# PRODUCT_DB_SCHEMA=product_service
# CUSTOMER_DB_SCHEMA=customer_service
# ORDER_DB_SCHEMA=order_service
